# Supabase project URL: Dashboard → Project Settings → Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# Secret key (sb_secret_...): Dashboard → Project Settings → API Keys → Secret keys.
# Server-side only — it bypasses Row Level Security, so never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# Signs the player session cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET=replace_me_with_32_bytes_of_random

# ElevenLabs API key, used to speak coach lines (/api/coach-voice) and to clone
# uploaded voice samples. Optional: without it that route returns 503 and both
# clients fall back to silent previews, samples are still stored and onboarding
# still finishes, the voices just stay uncloned. Dashboard → Profile → API Keys.
ELEVENLABS_API_KEY=

# Canonical site URL for metadata, sitemaps and Open Graph. Use localhost in
# dev; set to https://peanutbutter.fitness on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Needed later, when accounts are added (publishable key is safe in the browser):
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Mobile app (set in EAS / Expo build env, not in the web .env.local):
# EXPO_PUBLIC_API_URL=https://peanutbutter.fitness
